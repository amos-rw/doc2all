# Copy this file to .env (which git ignores). On a developer's computer everything here is optional.

# Where the processing programs are. Leave empty to find them automatically.
SOFFICE_PATH=
TESSERACT_PATH=
# Folder with the Tesseract language files (eng, fra, ...). Empty = the ones installed with Tesseract.
TESSDATA_DIR=

# Seconds one job may take.
CONVERTER_TIMEOUT=60
# Memory one program may take, in MB.
CONVERTER_MEMORY_MB=1024
# Folder for temporary files. Empty = the system temp folder.
CONVERTER_WORKDIR=

# For a real deployment only. Setting the first switches development mode off. Never commit a real value.
# AUDIT_KEY=
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
