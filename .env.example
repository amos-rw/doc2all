# Copy this file to .env (which git ignores). On a developer's computer everything here is optional.

# Where the processing programs are. Leave empty to find them automatically.
SOFFICE_PATH=
TESSERACT_PATH=
# Folder with the Tesseract language files (eng, fra, ...). Empty = the ones installed with Tesseract.
TESSDATA_DIR=

# Seconds one job may take.
CONVERTER_TIMEOUT=60
# Folders for temporary files and for LibreOffice's own settings. Empty = the system temp folder.
CONVERTER_WORKDIR=
CONVERTER_PROFILE_DIR=

# For a real deployment only. Setting it switches development mode off. Never commit a real value.
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
